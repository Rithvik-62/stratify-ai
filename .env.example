# STRATIFY — Decision Intelligence Platform Environment Template (.env.example)
# Copy this file to .env and insert your real credentials.

# Snowflake Data Warehouse Credentials
SNOWFLAKE_ACCOUNT=your_account_name
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=NOVAKART_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Optional DeepSeek & Search APIs
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Gmail SMTP Email Distribution Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password
RECIPIENT_EMAIL=your_recipient_email@gmail.com

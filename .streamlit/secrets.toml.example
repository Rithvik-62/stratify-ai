# ============================================================
# STRATIFY — Streamlit Cloud Secrets Configuration Template
# ============================================================
# In Streamlit Cloud (share.streamlit.io):
# Go to App Settings > Secrets and paste your real values:

# Snowflake Data Warehouse Credentials
SNOWFLAKE_ACCOUNT = "your_account_name"
SNOWFLAKE_USER = "your_username"
SNOWFLAKE_PASSWORD = "your_password"
SNOWFLAKE_DATABASE = "NOVAKART_DB"
SNOWFLAKE_SCHEMA = "ANALYTICS"
SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"
SNOWFLAKE_ROLE = "ACCOUNTADMIN"

# Optional AI & Search API Keys
DEEPSEEK_API_KEY = "your_deepseek_api_key_here"
SERPER_API_KEY = "your_serper_api_key_here"

# Gmail SMTP Email Distribution
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "your_email@gmail.com"
SMTP_PASSWORD = "your_16_character_gmail_app_password"
RECIPIENT_EMAIL = "recipient_email@gmail.com"

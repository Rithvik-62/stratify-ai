# ============================================================
# STRATIFY — Git Ignore Configuration (.gitignore)
# Protect Sensitive Credentials, Caches, & Generated Artifacts
# ============================================================

# Environment Variables & Sensitive Credentials
.env
*.env
.env.*
!.env.example
.streamlit/secrets.toml
!.streamlit/secrets.toml.example

# Python Caches & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Generated Runtime Files, Logs, & Batch Outputs
reports/*.pdf
reports/archive/
realtime/data/*.csv
realtime/logs/*.csv
realtime/rejected/*.csv
realtime/processed/*.csv
realtime/processed_ready/*.csv
realtime/incoming/*.csv
uipath/uipath_execution_log.csv
uipath/.local/
uipath/.tmh/
uipath/.objects/
uipath/.settings/
uipath/.entities/
*.log

# Backups & Checkpoints
archive_unused/
*.bak
alteryx/*.bak
.ipynb_checkpoints/

# IDEs & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.project/
**/.project/
**/.project
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.streamlit/config.toml.bak
.gemini/
.agents/
.tempmediaStorage/

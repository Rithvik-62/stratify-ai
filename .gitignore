# ============================================================
# STRATIFY — Git Ignore Configuration (.gitignore)
# Protect Sensitive Credentials, Caches, & Archived Files
# ============================================================

# Archive Unused Legacy Folder & Migration Audit
archive_unused/

# Environment Variables & Sensitive Credentials
.env
*.env
.env.*
!.env.example

# Python Caches & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Streamlit Caches & State
.streamlit/config.toml.bak
.streamlit/secrets.toml

# Antigravity IDE & Gemini Internal Directories
.gemini/
.agents/
.tempmediaStorage/

# Log Files & Audit Buffers
*.log
realtime/incoming/*.csv
realtime/processed/*.csv

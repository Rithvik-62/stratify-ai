# ============================================================
# STRATIFY — Gemini CLI Workspace Ignore Configuration (.geminiignore)
# Exclude Heavy Caches, Virtual Envs, & Archived Folders
# ============================================================

archive_unused/
.git/
.idea/
.vscode/
.env
*.env
__pycache__/
*.pyc
venv/
.venv/
env/
*.log
.gemini/
